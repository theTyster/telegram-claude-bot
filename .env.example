# Copy to .env and fill in. Keep this file private (chmod 600 .env).

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Your family group's chat id (a negative number, e.g. -1001234567890).
FAMILY_CHAT_ID=
# Your own Telegram user id. You have no daily limit and can DM the bot.
OWNER_USER_ID=

# Fill in the one matching AUTH_MODE (set in docker-compose.yml, default api_key).
# api_key: from https://console.anthropic.com (set a monthly spend limit there).
ANTHROPIC_API_KEY=
# subscription: run `claude setup-token` on your computer and paste the token.
# Read the README's warning about using a personal subscription first.
CLAUDE_CODE_OAUTH_TOKEN=

# Only for TRANSPORT=webhook.
# TELEGRAM_WEBHOOK_SECRET=
# WEBHOOK_PUBLIC_URL=https://example.com/telegram
